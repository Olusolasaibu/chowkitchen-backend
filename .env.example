# Copy this file to .env and fill in your own keys. Never commit .env.
# Get both keys from the Paystack Dashboard: Developers -> API Keys & Webhooks.

# Public key: safe to expose in the frontend checkout.
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here

# Secret key: server-side only. Never put this in frontend code or in git.
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

PORT=4000
